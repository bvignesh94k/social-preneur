{
  "name": "socialpreneur",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @sp/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @sp/db generate",
    "db:migrate": "pnpm --filter @sp/db migrate",
    "db:dev": "pnpm --filter @sp/db dev",
    "seed": "pnpm --filter @sp/web seed"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
