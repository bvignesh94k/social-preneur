// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  website   String?
  industry  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages     Page[]
  posts     Post[]
  campaigns Campaign[]
}

model Page {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  platform  String   // "linkedin", "facebook", "twitter", "instagram", "pinterest"
  name      String   // Page name (e.g., company page name)
  pageId    String   // Platform-specific page ID
  accessToken String?
  refreshToken String?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts     Post[]
  analytics PostAnalytic[]

  @@unique([clientId, platform, pageId])
}

model Post {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  content   String
  media     String[] // URLs to images/videos

  status    String   @default("draft") // "draft", "scheduled", "published"
  scheduledAt DateTime?
  publishedAt DateTime?

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  platformPostId String? // Post ID from the platform

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  analytics PostAnalytic[]
}

model Campaign {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  name      String
  description String?
  status    String   @default("active") // "active", "paused", "completed"

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts     Post[]
}

model PostAnalytic {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  views     Int      @default(0)
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  clicks    Int      @default(0)
  impressions Int    @default(0)

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
