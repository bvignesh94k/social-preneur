# Database
DATABASE_URL=postgresql://user:password@localhost:5432/social_preneur

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth (add as you connect platforms)
# NEXT_PUBLIC_LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# NEXT_PUBLIC_FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# NEXT_PUBLIC_INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=

# X (Twitter)
# NEXT_PUBLIC_X_CLIENT_ID=
# X_CLIENT_SECRET=

# AI Provider
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Feature flags
NEXT_PUBLIC_ENABLE_SCHEDULING=true
