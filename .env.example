# Copy to apps/web/.env.local for local development.
# Production values live in the Vercel project settings.

BETTER_AUTH_SECRET=          # 32+ chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres   # pnpm db:dev starts this
DATABASE_POOL_MAX=10

# Shows the one-time /setup page while no agency exists. 24+ chars.
SETUP_TOKEN=

# Encrypts stored OAuth tokens at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# LinkedIn developer app. Redirect URL to register with LinkedIn:
#   http://localhost:3000/api/oauth/linkedin/callback
#   https://socialpreneur.in/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

AI_PROVIDER=gemini
GEMINI_API_KEY=
