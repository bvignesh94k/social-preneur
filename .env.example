# Copy to apps/web/.env.local for local development.
# Production values live in the Vercel project settings.

BETTER_AUTH_SECRET=          # 32+ chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres   # pnpm db:dev starts this
DATABASE_POOL_MAX=10

# Shows the one-time /setup page while no agency exists. 24+ chars.
SETUP_TOKEN=

# Encrypts stored OAuth tokens at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Lets the scheduler call /api/cron/publish. 32+ chars. Set the same value in
# Vercel and as a GitHub Actions repository secret named CRON_SECRET.
CRON_SECRET=

# LinkedIn developer app. Redirect URL to register with LinkedIn:
#   http://localhost:3000/api/oauth/linkedin/callback
#   https://socialpreneur.in/api/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta app (Facebook Pages). Redirect URL to register under Facebook Login for
# Business > Settings > Valid OAuth Redirect URIs:
#   https://socialpreneur.in/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
# Optional: Facebook Login for Business > Configurations. Without it the
# Page permissions are requested by scope instead.
META_LOGIN_CONFIG_ID=

# Threads app (its own ID/secret, separate from the Meta app above, even when
# added as a use case on the same app). Redirect URL to register under
# Access the Threads API > Settings > Redirect Callback URLs:
#   https://socialpreneur.in/api/oauth/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=

AI_PROVIDER=gemini
GEMINI_API_KEY=
